# ============================================================
# 复制本文件为 .env，然后填入你自己的 Key
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 必填 ----------
# 你的 API Key（本地 Ollama / vLLM 没有鉴权，随便填一个非空字符串即可，例如 ollama）
LLM_API_KEY=sk-在这里填你自己的key

# ---------- 接口地址与模型 ----------
# OpenAI 兼容接口的 base_url（注意结尾是 /v1，且不要带 /chat/completions）
LLM_BASE_URL=https://api.openai.com/v1

# 默认模型
LLM_MODEL=gpt-5.6-luna

# 可选：按角色分模型（留空则都用 LLM_MODEL）
#   执行类角色 analyst / architect / coder 用 FAST
#   决策类角色 boss / reviewer / critic 用 SMART
# 这就是文档里说的「小模型干子任务 + 大模型做决策」
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# ---------- 可选：生成参数 ----------
# 单次调用的输出上限（含推理模型的「思考」token）
LLM_MAX_TOKENS=4096

# 是否让模型「思考」：
#   off（默认）关掉思考 -> 更快、更便宜、content 不会空
#   on         开着思考 -> 能亲眼看思考 token 怎么烧钱，V3 那节课特别有画面感
LLM_THINKING=off

# ---------- 可选：费用换算 ----------
# 单价单位是「元 / 百万 token」。留空则只显示 token 数，不算钱。
LLM_PRICE_IN=
LLM_PRICE_OUT=

# ---------- 可选：预算熔断 ----------
# Guard 的第 4 道刹车：累计超过这个 token 数就直接停
LLM_TOKEN_BUDGET=60000
