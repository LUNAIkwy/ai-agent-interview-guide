# ============================================================
# 复制本文件为 .env 后填写（PowerShell: Copy-Item .env.example .env）
#
# 重要：这个 lab **默认是离线的**（用可编排故障的假供应商），
#       不配任何东西也能跑通 V1~V7：`python run_all.py`
#       只有加了 --live 才会真的去调模型、才会花钱。
# ============================================================

# ---------- 只有 --live 才需要 ----------
# 你的 API Key（本地 Ollama / vLLM 没有鉴权，随便填个非空串，例如 ollama）
LLM_API_KEY=
# OpenAI 兼容接口地址，结尾是 /v1，别带 /chat/completions
LLM_BASE_URL=https://api.openai.com/v1
# 默认模型
LLM_MODEL=gpt-4o-mini
# 单次调用输出上限
LLM_MAX_TOKENS=1024

# ---------- 可选：把 token 折算成钱（元 / 百万 token） ----------
# 填了它，V3 的账本和 V6/V7 的成本门禁才有真实的金额；不填就是 0 元。
LLM_PRICE_IN=
LLM_PRICE_OUT=

# ---------- 可选：预算告警（元） ----------
# V3 场景 B 会拿它和账本比，超了就喊「该熔断了」。
LLM_BUDGET_YUAN=